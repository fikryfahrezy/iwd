{
  "name": "iwd",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "prepare": "lefthook install",
    "validate": "bun run format:check && bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
